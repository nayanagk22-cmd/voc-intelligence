# --- Required -------------------------------------------------------------
OPENAI_API_KEY=

# --- OpenAI models (gpt-4o-mini recommended; set SYNTH to gpt-4o for richer prose)
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SYNTH=gpt-4o-mini

# --- Database (change both passwords for anything beyond local review) ----
POSTGRES_DB=voc
POSTGRES_USER=voc_admin
POSTGRES_PASSWORD=change_me_admin
READONLY_DB_USER=voc_reader
READONLY_DB_PASSWORD=change_me_reader

# --- Data: file in ./data to seed (.xlsx or .csv). If missing, the first
# .xlsx/.csv in ./data is used.
DATA_FILE_NAME=enriched_unified_data.xlsx
FORCE_RESEED=false

# --- Guardrails / runtime --------------------------------------------------
MAX_SQL_ATTEMPTS=3
SQL_STATEMENT_TIMEOUT_MS=10000
LOG_LEVEL=INFO
FRONTEND_PORT=3000
BACKEND_PORT=8000
